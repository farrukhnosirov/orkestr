{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orkestr",
  "identifier": "dev.orkestr.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Orkestr",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost ws://127.0.0.1:* http://127.0.0.1:* ws://localhost:*",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: asset: http://asset.localhost",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "media-src": "'self' blob: data:",
        "frame-src": "'self' orkestr-widget: http://orkestr-widget.localhost http://vscode.tauri.localhost:*"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "Orkestr",
    "copyright": "Copyright (c) Orkestr contributors. MIT OR Apache-2.0.",
    "homepage": "https://orkestr.dev",
    "category": "DeveloperTool",
    "shortDescription": "AI Development OS",
    "longDescription": "Orkestr — AI Development OS: orchestrates AI coding agents, providers and tools on your machine.",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "certificateThumbprint": null,
      "timestampUrl": "",
      "allowDowngrades": true,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Russian"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "Orkestr",
        "installerHooks": "windows/installer-hooks.nsh",
        "compression": "lzma"
      },
      "wix": {
        "upgradeCode": "c6529465-36f6-467f-aca3-22bbb51d90b1",
        "language": [
          "en-US",
          "ru-RU"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFEMEU4MEIwNDI3NzE3NTAKUldSUUYzZENzSUFPSFpYdUdBQTNXTHVsK3k0Um5MZjJCUEg5bEpyU05pbzBzWmpieHJGSWRJMkQK",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
