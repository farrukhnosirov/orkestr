{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: custom title bar window controls, fullscreen, hide-to-tray and tray events, plus the native open / save dialogs (`dialog:allow-open`, `dialog:allow-save` for File → Save As…, for Browse… and File → Open) and every shell command (app commands are declared in build.rs, so other windows only get what their capability grants). Business data never flows through Tauri — the webview talks to the core over the RPC protocol.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "dialog:allow-open",
    "dialog:allow-save",
    "allow-core-connection",
    "allow-widget-document",
    "allow-shell-set-prefs",
    "allow-shell-quit",
    "allow-set-ui-language",
    "allow-window-list-monitors",
    "allow-window-open-panel",
    "allow-window-close-panel",
    "allow-window-redock-panel",
    "allow-window-list-panels",
    "allow-window-main-placement",
    "allow-window-move-to-monitor",
    "allow-window-reconcile",
    "allow-hud-show",
    "allow-hud-hide",
    "allow-hud-toggle",
    "allow-hud-collapse",
    "allow-hud-expand",
    "allow-orb-show",
    "allow-orb-hide",
    "allow-orb-toggle-hub",
    "allow-orb-reset-position",
    "allow-orb-set-shape",
    "allow-orb-set-layout",
    "allow-orb-to-main",
    "allow-vscode-window-open",
    "allow-vscode-window-close",
    "allow-vscode-window-reload",
    "allow-vscode-window-is-open",
    "allow-vscode-open-external"
  ]
}
