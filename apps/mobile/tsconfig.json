{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": [
      "jest",
      "node"
    ],
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@orkestr/client": [
        "../../packages/client/src/index.ts"
      ],
      "@orkestr/protocol": [
        "../../packages/protocol/src/index.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "android",
    "ios"
  ]
}
