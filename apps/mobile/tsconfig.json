{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["jest", "node"],
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@orkestr/client": ["../../packages/client/src/index.ts"],
      "@orkestr/protocol": ["../../packages/protocol/src/index.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules", "android", "ios"]
}
