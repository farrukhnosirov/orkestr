{
  "name": "orkestr",
  "version": "0.1.0",
  "private": true,
  "description": "Orkestr — AI Development OS (monorepo root)",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "gen:protocol": "node scripts/gen-protocol.mjs",
    "build": "npm run build:packages && npm run build -w @orkestr/desktop",
    "build:packages": "npm run build -w @orkestr/protocol && npm run build -w @orkestr/client && npm run build -w @orkestr/ui",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev": "npm run dev -w @orkestr/desktop",
    "tauri": "npm run tauri -w @orkestr/desktop",
    "icons": "node scripts/gen-icon.mjs && npm run tauri -w @orkestr/desktop -- icon src-tauri/icons/source.png"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vitest": "^5.0.3",
    "vite": "^8.3.2",
    "jsdom": "^30.1.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/dom": "^10.4.2",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
