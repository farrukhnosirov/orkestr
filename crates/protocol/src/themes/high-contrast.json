{
  "id": "high-contrast",
  "name": "High Contrast",
  "mode": "Dark",
  "description": "Accessibility theme: pure black, solid surfaces, no blur or motion, AAA text contrast.",
  "author": "Orkestr",
  "tokens": {
    "color-bg": "#000000",
    "color-bg-elevated": "#0a0a0a",
    "color-surface": "#0b0b0b",
    "color-surface-strong": "#111111",
    "color-surface-sunken": "#000000",
    "color-surface-hover": "#1f1f1f",
    "color-surface-active": "#2a2a2a",
    "color-overlay": "rgba(0, 0, 0, 0.82)",
    "color-border": "#8a8a8a",
    "color-border-strong": "#ffffff",
    "color-border-accent": "#ffd60a",
    "color-text": "#ffffff",
    "color-text-muted": "#e0e0e0",
    "color-text-subtle": "#b8b8b8",
    "color-text-inverse": "#000000",
    "color-accent": "#ffd60a",
    "color-accent-strong": "#ffea00",
    "color-accent-soft": "rgba(255, 214, 10, 0.2)",
    "color-violet": "#c4b5fd",
    "color-violet-strong": "#a78bfa",
    "color-magenta": "#f9a8d4",
    "color-success": "#4ade80",
    "color-warning": "#fde047",
    "color-danger": "#ff8080",
    "color-info": "#93c5fd",
    "gradient-accent": "linear-gradient(135deg, #ffd60a 0%, #ffd60a 100%)",
    "gradient-panel": "linear-gradient(180deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0) 100%)",
    "gradient-space": "#000000",
    "shadow-panel": "0 0 0 1px #8a8a8a",
    "focus-ring": "0 0 0 2px #000000, 0 0 0 4px #ffd60a"
  },
  "effects": { "blurPx": 0, "glowIntensity": 0, "panelOpacity": 1, "animations": false },
  "background": {
    "kind": "Solid",
    "colors": [],
    "intensity": 0,
    "speed": 0,
    "density": 0,
    "webgl": false
  },
  "motion": { "intensity": 0, "speed": 1 },
  "sounds": {
    "enabled": true,
    "volume": 0.7,
    "events": {
      "agent.error": "alert-low",
      "approval.requested": "ping",
      "task.completed": "chime-soft"
    }
  },
  "robot": { "skin": "block", "scale": 1.1, "accent": "#ffd60a" }
}
