{
  "name": "@orkestr/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Orkestr design system: tokens (--ok-*), theme engine, React primitives",
  "type": "module",
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles/index.css"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "src/styles"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@orkestr/protocol": "0.1.0",
    "clsx": "^2.1.1"
  },
  "peerDependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  }
}
